a
<DIAD DO='PING' />
<DIAD DO='PARAMETER'>
   <SET KEY='FILEMODE' VALUE='FAIT_FILES' />
   <SET KEY='SEEDE_STEPS' VALUE='1000000' />
   <SET KEY='SEEDE_DEPTH'>100</SET>
</DIAD>

<LIMBA DO='SETMODEL' MODEL='devstral-2:latest' />

<DIAD DO='SETUPBUBBLES' MINT='BUBBLES_spr_nanoxml' WORKSPACE='nanoxml' />

<DIAD DO='TEST' PROJECT='nanoxml' LAUNCH='testParsing16' CONTINUE='0' />
<DIAD DO='WAITFORSTATE' STATE='READY' />
<DIAD DO='Q_STACK' DEBUGID='$ID' />
<DIAD DO='Q_LOCATIONS' DEBUGID='$ID' ALL='false' />
<DIAD DO='Q_LOCATIONS' DEBUGID='$ID' ALL='true' />
<DIAD DO='Q_EXECTRACE' DEBUGID='$ID' CALLID='3' />
<DIAD DO='Q_LINETRACE' DEBUGID='$ID' CALLID='3' />
<DIAD DO='Q_VARTRACE' DEBUGID='$ID' CALLID='3' VARIABLE='inputXmlContent' />
<DIAD DO='Q_VARVALUE' DEBUGID='$ID' CALLID='3'
	VARIABLE='xml'
	WHEN='55626' />
<DIAD DO='Q_VARVALUE' DEBUGID='$ID' CALLID='3'
	VARIABLE='xml?children?elementData?[0]?qualifiedName'
	WHEN='55626' />
<DIAD DO='Q_VARHISTORY' DEBUGID='$ID' CALLID='3'
	VARIABLE='xml?children?elementData?[0]?qualifiedName'
	WHEN='55626' />
<DIAD DO='Q_METHODCALLS' DEBUGID='$ID' METHOD='net.n3.nanoxml.XMLElement.getChildAtIndex(int)' />

<DIAD DO='ASKLIMBA' DEBUGID='$ID' TYPE='EXPLAIN' NOHISTORY='true' />
<DIAD DO='ASKLIMBA' DEBUGID='$ID' TYPE='TEST1' NOHISTORY='true' />
<DIAD DO='ASKLIMBA' DEBUGID='$ID' TYPE='TEST2' NOHISTORY='true' />
<DIAD DO='ASKLIMBA' DEBUGID='$ID' TYPE='TEST3' NOHISTORY='true' />
<DIAD DO='ASKLIMBA' DEBUGID='$ID' TYPE='LOCATIONS' NOHISTORY='true' />
<DIAD DO='ASKLIMBA' DEBUGID='$ID' TYPE='REPAIRS' NOHISTORY='true' />

<DIAD DO='EXIT' />

