<DIAD DO='PING' />
<DIAD DO='PARAMETER'>
   <SET KEY='FILEMODE' VALUE='FAIT_FILES' />
   <SET KEY='SEEDE_STEPS' VALUE='10000000' />
   <SET KEY='SEEDE_DEPTH'>100</SET>
   <SET KEY='AUTO_QUERY'>false</SET>
   <SET KEY='Diad.seede.debug'>true</SET>
   <SET KEY='Diad.seede.trace'>true</SET>
   <SET KEY='Diad.fait.debug'>true</SET>
   <SET KEY='Diad.fait.trace'>true</SET>
</DIAD>

<DIAD DO='SETUPBUBBLES' MINT='BUBBLES_spr_tc2' WORKSPACE='tc2' />

<DIAD DO='SETMODEL' MODEL='qwen3-coder:latest' />

<DIAD DO='TEST' PROJECT='tc2' LAUNCH='t07OrderCancelTest' CONTINUE='0' />
<DIAD DO='WAITFORSTATE' STATE='READY' />
<DIAD DO='CLEARHISTORY' DEBUGID='$ID' />
<DIAD DO='ASKLIMBA' DEBUGID='$ID' TYPE='REPAIRS' />

<DIAD DO='EXIT' />
