<DIAD DO='PING' />
<DIAD DO='PARAMETER'>
   <SET KEY='FILEMODE' VALUE='FAIT_FILES' />
   <SET KEY='SEEDE_STEPS' VALUE='1000000' />
   <SET KEY='SEEDE_DEPTH'>100</SET>  +
   <SET KEY='AUTO_QUERY'>false</SET>
   <SET KEY='Diad.seede.debug'>true</SET>
   <SET KEY='Diad.seede.trace'>true</SET>
   <SET KEY='Diad.fait.debug'>true</SET>
   <SET KEY='Diad.fait.trace'>true</SET>
</DIAD>

<DIAD DO='SETUPBUBBLES' MINT='BUBBLES_spr_tutorial' WORKSPACE='tutorial' />


<DIAD DO='TEST' PROJECT='romp' LAUNCH='ROMP bad' CONTINUE='0' />
<DIAD DO='WAITFORSTATE' STATE='READY' />

<DIAD DO='Q_LOCATIONS' DEBUGID='$ID' ALL='false' />
<DIAD DO='Q_LOCATIONS' DEBUGID='$ID' ALL='true' />
<DIAD DO='Q_EXECTRACE' DEBUGID='$ID' CALLID='0' />
<DIAD DO='Q_LINETRACE' DEBUGID='$ID' CALLID='0' />

<DIAD DEBUGID='$ID' DO='SYMPTOM'>
<SYMPTOM TYPE='OTHER'>
  <USER><![CDATA[Bad file name]]></USER>
  <VARIABLES><![CDATA[infile]]></VARIABLES>
  <ASSERTION><![CDATA[]]></ASSERTION>
</SYMPTOM>
</DIAD>

<DIAD DO='WAITFORSTATE' STATE='DOING_ANALYSIS' />
<DIAD DO='WAITFORSTATE' STATE='READY' />



<DIAD DO='EXIT' />

