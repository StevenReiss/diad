<project name='diad' default='all'>

   <property file='build.properties' />

   <available file="./build.properties" type='file' property='setup.done' />
   <path id='setuppath'>
      <pathelement location='..' />
   </path>
   <path id='diadpath'>
      <pathelement location='.' />
   </path>
   <property name='setupfile' refid='setuppath' />
   <property name='diadfile' refid='diadpath' />
   <property name='PRO' value='${setupfile}' />
   <property name='DIAD' value='${diadfile}' />

   <property name='TDIR' value='/home/spr/diadtest' />
   <property name='EDIR' value='/home/spr/Eclipse' />


   <target name='setup' unless='setup.done'>
      <echo file='./build.properties' message="PRO=${setupfile}${line.separator}" />
      <echo file='./build.properties' message='DIAD=${diadfile}${line.separator}' append='true' />
      <mkdir dir='./java/edu/brown/cs/diad' />
      <mkdir dir='./lib' />
      <property name='PRO' value='${setupfile}' />
      <property name='DIAD' value='${diadfile}' />
   </target>


   <available file='${PRO}/ivy' type="dir" property="ivy.present" />
   <property name='IVYLIB' value='${PRO}/ivy/lib' />

   <property name='DIADLIB' value='${DIAD}/lib' />
   <path id='spr.classpath'>
     <pathelement location='${DIAD}/java' />
     <pathelement location='${DIAD}/javasrc' />
     <fileset dir='${DIADLIB}' includes='*.jar' />
     <fileset dir='${IVYLIB}' includes='ivy.jar' />
     <fileset dir='${IVYLIB}' includes='junit.jar' />
     <fileset dir='${IVYLIB}' includes='asm.jar' />
     <fileset dir='${IVYLIB}' includes='json.jar' />
     <fileset dir='${PRO}/ivy/lib/eclipsejar' includes='*.jar' />
     <pathelement location='${DIAD}/resources' />
  </path>

  <target name='all' depends='setup,compile,jar' />

  <target name='compile' depends='setup'>
     <javac srcdir='.' destdir='${DIAD}/java' debug='on' deprecation='on'
		target='10' source='10'
		includeantruntime='false'>
	<classpath refid='spr.classpath' />
     </javac>
  </target>

  <target name='jar' depends='setup,compile'>
     <jar destfile='diad.jar'>
	<manifest>
	   <attribute name='Main-Class' value='edu.brown.cs.diad diad.GrainMain' />
	</manifest>
	<fileset dir='${DIAD}/java' includes='**/*.class' />
	<fileset dir='${DIAD}/resources' includes='*.xml' />
	<fileset dir='${DIAD}/resources' includes='*.proto' />
     </jar>
   </target>

   <target name='bubbles' depends='all'>
      <jar destfile='diad.jar'>
	 <manifest>
	    <attribute name="Bubbles-start" value='edu.brown.cs.diadbb.bird.BirdFactory' />
	    <attribute name="Bubbles-palette" value='diadbb.palette' />
	    <attribute name="Bubbles-resource" value='Bird.props Diad.props' />
	    <attribute name="Bubbles-depends" value='' />
	 </manifest>
	 <fileset dir='${DIAD}/java' includes='**/*.class' />
	 <fileset dir='${PRO}/diadbb/java' includes='**/*.class' />
	 <fileset dir='${DIAD}/resources' includes='*.xml' />
	 <fileset dir='${DIAD}/resources' includes='images/*.png' />
	 <fileset dir='${DIAD}/resources' includes='Diad.props' />
<!--	 <fileset dir='${PRO}/ivy/java' includes='**/*.class' />                        -->
	 <fileset dir='${PRO}/diadbb' includes='Bird.props' />
	 <fileset dir='${PRO}/diadbb' includes='diadbb.palette' />
      </jar>
      <copy file='diad.jar' tofile='${PRO}/bubbles/dropins/diad.jar' verbose='true' />
      <copy file='diad.jar' tofile='${PRO}/bubbles/dropins.export/diad.jar' verbose='true' />
   </target>

   <target name='testtc1-1' depends='compile'>
      <delete file='${EDIR}/tc1/limbatrans.html' />
      <java classname='edu.brown.cs.diad.dicontrol.DicontrolMain' fork='true'
		output='${TDIR}/diad-tc1-1-err.out'>
	 <classpath refid='spr.classpath' />
	 <assertions><enable/></assertions>
	 <arg value="-f" />
	 <arg value="/pro/diad/testtc1-1.xml" />
	 <arg value="-D" />
	 <arg value="-L" />
	 <arg value="${TDIR}/diad-tc1-1.out" />
      </java>
      <copy file='${EDIR}/tc1/limbatrans.html' tofile='${TDIR}/limba-tc1-1.html' />
   </target>

   <target name='testtc1-2' depends='compile'>
      <delete file='${EDIR}/tc1/limbatrans.html' />
      <java classname='edu.brown.cs.diad.dicontrol.DicontrolMain' fork='true'
		output='${TDIR}/diad-tc1-2-err.out'>
	 <classpath refid='spr.classpath' />
	 <assertions><enable/></assertions>
	 <arg value="-f" />
	 <arg value="/pro/diad/testtc1-2.xml" />
	 <arg value="-D" />
	 <arg value="-L" />
	 <arg value="${TDIR}/diad-tc1-2.out" />
      </java>
      <copy file='${EDIR}/tc1/limbatrans.html' tofile='${TDIR}/limba-tc1-2.html' />
   </target>

   <target name='testtc1-3' depends='compile'>
      <delete file='${EDIR}/tc1/limbatrans.html' />
      <java classname='edu.brown.cs.diad.dicontrol.DicontrolMain' fork='true'
		output='${TDIR}/diad-tc1-3-err.out'>
	 <classpath refid='spr.classpath' />
	 <assertions><enable/></assertions>
	 <arg value="-f" />
	 <arg value="/pro/diad/testtc1-3.xml" />
	 <arg value="-D" />
	 <arg value="-L" />
	 <arg value="${TDIR}/diad-tc1-3.out" />
      </java>
      <copy file='${EDIR}/tc1/limbatrans.html' tofile='${TDIR}/limba-tc1-3.html' />
   </target>

   <target name='testtc1-4' depends='compile'>
      <delete file='${EDIR}/tc1/limbatrans.html' />
      <java classname='edu.brown.cs.diad.dicontrol.DicontrolMain' fork='true'
		output='${TDIR}/diad-tc1-4-err.out'>
	 <classpath refid='spr.classpath' />
	 <assertions><enable/></assertions>
	 <arg value="-f" />
	 <arg value="/pro/diad/testtc1-4.xml" />
	 <arg value="-D" />
	 <arg value="-L" />
	 <arg value="${TDIR}/diad-tc1-4.out" />
      </java>
      <copy file='${EDIR}/tc1/limbatrans.html' tofile='${TDIR}/limba-tc1-4.html' />
   </target>

   <target name='testnano' depends='compile'>
      <delete file='${EDIR}/nanoxml/limbatrans.html' />
      <java classname='edu.brown.cs.diad.dicontrol.DicontrolMain' fork='true'
		output='${TDIR}/diad-nanoxml-err.out'>
	 <classpath refid='spr.classpath' />
	 <assertions><enable/></assertions>
	 <arg value="-f" />
	 <arg value="/pro/diad/testnano.xml" />
	 <arg value="-D" />
	 <arg value="-L" />
	 <arg value="${TDIR}/diad-nanoxml.out" />
      </java>
      <copy file='${EDIR}/nanoxml/limbatrans.html' tofile='${TDIR}/limba-nanoxml.html' />
   </target>

   <target name='testtc1' depends='testtc1-1,testtc1-2,testtc1-3,testtc1-4' />
   <target name='tests' depends='testtc1,testnano' />


</project>
